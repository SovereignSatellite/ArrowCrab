{
  "name": "arrowcrab",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run format:check && npm run verify:dependencies && astro build && npm run verify:examples",
    "verify:dependencies": "node scripts/verify-dependency-policy.mjs",
    "verify:examples": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/verify-examples.mjs",
    "verify:layout": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/verify-layout.mjs",
    "benchmark:layout": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/benchmark-layout.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "^5.9.3"
  }
}
