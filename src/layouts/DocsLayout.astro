---
interface Props {
  title: string;
}

const { title } = Astro.props;

const base = import.meta.env.BASE_URL;

const navItems = [
  { href: `${base}/docs/`, label: "Overview" },
  { href: `${base}/docs/data-format/`, label: "Data Format" },
  { href: `${base}/docs/layout-algorithm/`, label: "Layout Algorithm" },
  { href: `${base}/docs/rendering/`, label: "Rendering" },
  { href: `${base}/docs/interaction/`, label: "Interaction" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || `${base}/docs`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} Docs</title>
  </head>
  <body>
    <header>
      <a href={`${base}/`} class="logo">ArrowCrab</a>
      <span class="separator">/</span>
      <a href={`${base}/docs/`} class="docs-link">Docs</a>
    </header>
    <div class="layout">
      <nav>
        <ul>
          {
            navItems.map((item) => {
              const itemPath = item.href.replace(/\/$/, "");
              const isActive = currentPath === itemPath;
              return (
                <li>
                  <a href={item.href} class:list={[{ active: isActive }]}>
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="nav-footer">
          <a href={`${base}/`}>Graph Viewer</a>
        </div>
      </nav>
      <main>
        <h1>{title}</h1>
        <slot />
      </main>
    </div>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scrollbar-color: #444 #1a1a1a;
      }

      body {
        background: #141414;
        color: #ccc;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        line-height: 1.6;
        min-height: 100vh;
      }

      header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 14px 24px;
        border-bottom: 1px solid #2a2a2a;
        background: rgba(20, 20, 20, 0.95);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .logo {
        font-weight: 700;
        font-size: 1rem;
        color: #fff;
        text-decoration: none;
        letter-spacing: -0.02em;
      }

      .separator {
        color: #444;
        font-size: 0.9rem;
      }

      .docs-link {
        color: #999;
        text-decoration: none;
        font-size: 0.9rem;
      }

      .docs-link:hover {
        color: #ccc;
      }

      .layout {
        display: flex;
        min-height: calc(100vh - 49px);
      }

      nav {
        width: 200px;
        flex-shrink: 0;
        border-right: 1px solid #2a2a2a;
        padding: 20px 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: sticky;
        top: 49px;
        height: calc(100vh - 49px);
        overflow-y: auto;
      }

      nav ul {
        list-style: none;
      }

      nav a {
        display: block;
        padding: 6px 24px;
        color: #888;
        text-decoration: none;
        font-size: 0.85rem;
        transition:
          color 0.1s,
          background 0.1s;
      }

      nav a:hover {
        color: #ccc;
        background: #1e1e1e;
      }

      nav a.active {
        color: #fff;
        background: #1e1e1e;
        border-right: 2px solid #fff;
      }

      .nav-footer {
        padding: 12px 24px;
        border-top: 1px solid #2a2a2a;
      }

      .nav-footer a {
        padding: 0;
        font-size: 0.8rem;
        color: #666;
      }

      .nav-footer a:hover {
        color: #999;
      }

      main {
        flex: 1;
        max-width: 740px;
        padding: 40px 48px 80px;
      }

      main h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 32px;
        letter-spacing: -0.03em;
      }

      main :global(h2) {
        font-size: 1.25rem;
        font-weight: 600;
        color: #eee;
        margin-top: 40px;
        margin-bottom: 16px;
        letter-spacing: -0.02em;
      }

      main :global(h3) {
        font-size: 1rem;
        font-weight: 600;
        color: #ddd;
        margin-top: 28px;
        margin-bottom: 12px;
      }

      main :global(p) {
        margin-bottom: 16px;
        color: #bbb;
        font-size: 0.92rem;
      }

      main :global(ul),
      main :global(ol) {
        margin-bottom: 16px;
        padding-left: 24px;
      }

      main :global(li) {
        margin-bottom: 6px;
        color: #bbb;
        font-size: 0.92rem;
      }

      main :global(code) {
        font-family: "SF Mono", "Cascadia Code", "Fira Code", monospace;
        font-size: 0.85em;
        background: #1e1e1e;
        padding: 2px 6px;
        border-radius: 3px;
        color: #ddd;
      }

      main :global(pre) {
        background: #1a1a1a;
        border: 1px solid #2a2a2a;
        border-radius: 6px;
        padding: 16px 20px;
        margin-bottom: 20px;
        overflow-x: auto;
        font-size: 0.82rem;
        line-height: 1.5;
      }

      main :global(pre code) {
        background: none;
        padding: 0;
        font-size: inherit;
      }

      main :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
        font-size: 0.85rem;
      }

      main :global(th) {
        text-align: left;
        padding: 8px 12px;
        border-bottom: 1px solid #333;
        color: #ddd;
        font-weight: 600;
      }

      main :global(td) {
        padding: 8px 12px;
        border-bottom: 1px solid #222;
        color: #aaa;
      }

      main :global(blockquote) {
        border-left: 3px solid #333;
        padding-left: 16px;
        margin-bottom: 16px;
        color: #888;
        font-style: italic;
      }

      main :global(strong) {
        color: #ddd;
        font-weight: 600;
      }

      main :global(a) {
        color: #7aa2f7;
        text-decoration: none;
      }

      main :global(a:hover) {
        text-decoration: underline;
      }

      main :global(hr) {
        border: none;
        border-top: 1px solid #2a2a2a;
        margin: 32px 0;
      }

      @media (max-width: 768px) {
        .layout {
          flex-direction: column;
        }

        nav {
          width: 100%;
          position: static;
          height: auto;
          border-right: none;
          border-bottom: 1px solid #2a2a2a;
          padding: 12px 0;
        }

        nav ul {
          display: flex;
          gap: 4px;
          padding: 0 16px;
          overflow-x: auto;
        }

        nav a {
          padding: 4px 12px;
          white-space: nowrap;
          border-radius: 4px;
        }

        nav a.active {
          border-right: none;
          background: #2a2a2a;
        }

        .nav-footer {
          display: none;
        }

        main {
          padding: 24px 20px 60px;
        }
      }
    </style>
  </body>
</html>
