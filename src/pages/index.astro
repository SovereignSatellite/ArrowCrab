---
import { getExampleGraphDefinitions } from "../lib/examples";

const base = import.meta.env.BASE_URL;
const examples = getExampleGraphDefinitions();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>ArrowCrab</title>
  </head>
  <body>
    <a
      id="docs-link"
      href={`${base}/docs/`}
      aria-label="Open ArrowCrab documentation"
    >
      Docs
    </a>
    <div id="drop-zone" role="region" aria-label="Graph input">
      <div id="drop-content">
        <button id="browse-btn" type="button">Choose JSON file</button>
        <div id="examples">
          <div id="example-list">
            {
              examples.map((example) => (
                <button
                  type="button"
                  class="example-btn"
                  data-example-url={`${base}/examples/${example.slug}.json`}
                  data-example-name={example.name}
                >
                  <span>{example.name}</span>
                  <small>{example.description}</small>
                </button>
              ))
            }
          </div>
        </div>
      </div>
      <input type="file" id="file-input" accept=".json" />
    </div>
    <canvas id="graph-gl-canvas" class="hidden" aria-hidden="true"></canvas>
    <canvas
      id="graph-canvas"
      class="hidden"
      role="img"
      aria-label="ArrowCrab graph viewer"
      aria-describedby="accessible-graph"
      tabindex="0"
    >
      <p>Your browser does not support the graph canvas.</p>
    </canvas>
    <button id="load-btn" class="hidden">Load JSON</button>
    <p id="status" role="status" aria-live="polite"></p>
    <div id="accessible-graph" class="visually-hidden" aria-live="polite"></div>

    <div id="controls" class="hidden">
      <div id="controls-row">
        <button
          id="zoom-out-btn"
          class="control-btn"
          aria-label="Zoom out (minus key)"
          title="Zoom out (−)">−</button
        >
        <input
          type="range"
          id="zoom-slider"
          min="10"
          max="500"
          value="100"
          aria-label="Zoom level"
        />
        <button
          id="zoom-in-btn"
          class="control-btn"
          aria-label="Zoom in (plus key)"
          title="Zoom in (+)">+</button
        >
        <span id="zoom-label">100%</span>
        <div class="control-divider"></div>
        <button
          id="fit-btn"
          class="control-btn fit-btn"
          aria-label="Fit graph to screen (0 key)"
          title="Fit to screen (0)">Fit</button
        >
      </div>
    </div>

    <script>
      import { buildGraphModel, type GraphData } from "../lib/graph";
      import type { LayoutSnapshot } from "../lib/scene";
      import type { GraphScene } from "../lib/rendering";
      import {
        createScene,
        centerViewport,
        render,
        handleCanvasClick,
        createWebGLRenderer,
      } from "../lib/rendering";
      import {
        setupViewport,
        type ViewportControls,
      } from "../lib/interaction/viewport";

      const dropZone = document.getElementById("drop-zone")!;
      const browseButton = document.getElementById(
        "browse-btn",
      ) as HTMLButtonElement;
      const exampleButtons =
        document.querySelectorAll<HTMLButtonElement>(".example-btn");
      const fileInput = document.getElementById(
        "file-input",
      ) as HTMLInputElement;
      const canvas = document.getElementById(
        "graph-canvas",
      ) as HTMLCanvasElement;
      const webglCanvas = document.getElementById(
        "graph-gl-canvas",
      ) as HTMLCanvasElement;
      const context = canvas.getContext("2d")!;
      const webglRenderer = createWebGLRenderer(webglCanvas);
      const loadButton = document.getElementById("load-btn")!;
      const controlsPanel = document.getElementById("controls")!;
      const zoomSlider = document.getElementById(
        "zoom-slider",
      ) as HTMLInputElement;
      const zoomLabel = document.getElementById("zoom-label")!;
      const zoomInButton = document.getElementById("zoom-in-btn")!;
      const zoomOutButton = document.getElementById("zoom-out-btn")!;
      const fitButton = document.getElementById("fit-btn")!;
      const status = document.getElementById("status")!;
      const accessibleGraph = document.getElementById("accessible-graph")!;
      const layoutWorker = new Worker(
        new URL("../lib/worker/layout-worker.ts", import.meta.url),
        { type: "module" },
      );

      let activeScene: GraphScene | null = null;
      let viewportControls: ViewportControls | null = null;
      let nextRequestId = 0;
      let currentLoad: { id: number } | null = null;

      function resizeCanvas(): void {
        const pixelRatio = window.devicePixelRatio || 1;
        canvas.width = canvas.clientWidth * pixelRatio;
        canvas.height = canvas.clientHeight * pixelRatio;
        webglRenderer?.resize(pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        if (activeScene) {
          centerViewport(activeScene);
          render(activeScene);
          updateZoomDisplay();
        }
      }

      function updateZoomDisplay(): void {
        if (!viewportControls) {
          return;
        }
        const percent = viewportControls.getZoomPercent();
        zoomSlider.value = String(percent);
        zoomLabel.textContent = `${percent}%`;
      }

      function showGraph(data: GraphData, snapshot: LayoutSnapshot): void {
        const model = buildGraphModel(data);
        dropZone.removeAttribute("aria-busy");
        dropZone.classList.add("hidden");
        webglCanvas.classList.remove("hidden");
        canvas.classList.remove("hidden");
        loadButton.classList.remove("hidden");
        controlsPanel.classList.remove("hidden");
        loadButton.focus({ preventScroll: true });
        status.textContent = "";
        accessibleGraph.textContent =
          `${model.indexed.nodeIds.length} nodes and ` +
          `${model.indexed.edgeSourceIndices.length} edges loaded. ` +
          "Use the canvas controls to inspect the graph; node and edge " +
          "selection is available by clicking the drawing.";

        if (viewportControls) viewportControls.destroy();
        activeScene = createScene(context, model, snapshot, webglRenderer);
        resizeCanvas();

        let renderPending = false;
        function scheduleRender(): void {
          if (!renderPending) {
            renderPending = true;
            requestAnimationFrame(() => {
              renderPending = false;
              if (activeScene) {
                render(activeScene);
              }
            });
          }
        }

        viewportControls = setupViewport(canvas, activeScene.viewport, {
          onRender: scheduleRender,
          onClick: (canvasX, canvasY, ctrlKey) => {
            if (activeScene) {
              handleCanvasClick(activeScene, canvasX, canvasY, ctrlKey);
            }
          },
          onZoomChange: (percent) => {
            zoomSlider.value = String(percent);
            zoomLabel.textContent = `${percent}%`;
          },
          onFitToScreen: () => {
            if (activeScene) {
              centerViewport(activeScene);
              render(activeScene);
            }
          },
        });

        updateZoomDisplay();
      }

      function setLoadingControlsDisabled(disabled: boolean): void {
        browseButton.disabled = disabled;
        exampleButtons.forEach((exampleButton) => {
          exampleButton.disabled = disabled;
        });
      }

      function startLoad(
        source: string,
        readJson: () => Promise<string>,
      ): void {
        const load = { id: ++nextRequestId };
        currentLoad = load;
        dropZone.setAttribute("aria-busy", "true");
        setLoadingControlsDisabled(true);
        status.textContent = `Loading ${source}…`;
        readJson()
          .then((json) => {
            if (currentLoad !== load) return;
            layoutWorker.postMessage({
              type: "layout",
              requestId: load.id,
              json,
            });
          })
          .catch((error: unknown) => {
            if (currentLoad !== load) return;
            currentLoad = null;
            dropZone.removeAttribute("aria-busy");
            setLoadingControlsDisabled(false);
            status.textContent =
              error instanceof Error
                ? error.message
                : `Unable to load ${source}.`;
          });
      }

      function handleFile(file: File): void {
        startLoad(file.name || "graph file", () => file.text());
      }

      function handleExample(button: HTMLButtonElement): void {
        const name = button.dataset.exampleName ?? "example graph";
        const url = button.dataset.exampleUrl;
        if (!url) return;
        startLoad(name, () =>
          fetch(url).then((response) => {
            if (!response.ok) throw new Error(`Unable to load ${name}.`);
            return response.text();
          }),
        );
      }

      layoutWorker.addEventListener("message", (event) => {
        const message = event.data as {
          type: string;
          requestId: number;
          phase?: string;
          message?: string;
          graphData?: GraphData;
          snapshot?: LayoutSnapshot;
        };
        if (!currentLoad || message.requestId !== currentLoad.id) return;
        if (message.type === "progress") {
          status.textContent = `${message.phase ?? "Working"}…`;
        } else if (message.type === "error") {
          currentLoad = null;
          dropZone.removeAttribute("aria-busy");
          setLoadingControlsDisabled(false);
          status.textContent = message.message ?? "Unable to load graph.";
        } else if (
          message.type === "ready" &&
          message.graphData &&
          message.snapshot
        ) {
          currentLoad = null;
          try {
            showGraph(message.graphData, message.snapshot);
          } catch (error) {
            dropZone.removeAttribute("aria-busy");
            setLoadingControlsDisabled(false);
            status.textContent =
              error instanceof Error
                ? error.message
                : "Unable to render graph.";
          }
        }
      });

      browseButton.addEventListener("click", () => fileInput.click());
      exampleButtons.forEach((button) => {
        button.addEventListener("click", () => {
          handleExample(button);
        });
      });
      fileInput.addEventListener("change", () => {
        if (fileInput.files?.[0]) {
          handleFile(fileInput.files[0]);
        }
      });

      dropZone.addEventListener("dragover", (event) => {
        event.preventDefault();
        dropZone.classList.add("drag-over");
      });
      dropZone.addEventListener("dragleave", () => {
        dropZone.classList.remove("drag-over");
      });
      dropZone.addEventListener("drop", (event) => {
        event.preventDefault();
        dropZone.classList.remove("drag-over");
        if (event.dataTransfer?.files[0]) {
          handleFile(event.dataTransfer.files[0]);
        }
      });

      zoomInButton.addEventListener("click", () => {
        viewportControls?.zoomIn();
      });
      zoomOutButton.addEventListener("click", () => {
        viewportControls?.zoomOut();
      });
      fitButton.addEventListener("click", () => {
        viewportControls?.fitToScreen();
      });
      zoomSlider.addEventListener("input", () => {
        viewportControls?.setZoomPercent(Number(zoomSlider.value));
      });

      loadButton.addEventListener("click", () => {
        canvas.classList.add("hidden");
        webglCanvas.classList.add("hidden");
        loadButton.classList.add("hidden");
        controlsPanel.classList.add("hidden");
        dropZone.classList.remove("hidden");
        fileInput.value = "";
        viewportControls?.destroy();
        viewportControls = null;
        activeScene = null;
        if (currentLoad) {
          layoutWorker.postMessage({
            type: "cancel",
            requestId: currentLoad.id,
          });
          currentLoad = null;
        }
        dropZone.removeAttribute("aria-busy");
        setLoadingControlsDisabled(false);
        status.textContent = "";
        accessibleGraph.textContent = "";
        browseButton.focus({ preventScroll: true });
      });

      window.addEventListener("resize", resizeCanvas);
      window.addEventListener("beforeunload", () => layoutWorker.terminate());
      resizeCanvas();
    </script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: #141414;
        color: #ccc;
        font-family: system-ui, sans-serif;
        overflow: hidden;
        width: 100vw;
        height: 100vh;
      }

      #drop-zone {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        cursor: default;
        border: 2px dashed #444;
        border-radius: 12px;
        margin: 40px;
        transition: border-color 0.15s;
      }

      #drop-zone:hover,
      #drop-zone.drag-over {
        border-color: #888;
      }

      #drop-content {
        width: min(680px, 100%);
        padding: 28px;
      }

      #file-input {
        display: none;
      }

      #browse-btn {
        margin-top: 16px;
        padding: 8px 16px;
        color: #eee;
        background: #333;
        border: 1px solid #555;
        border-radius: 7px;
        cursor: pointer;
        font-size: 0.85rem;
        transition:
          background 0.1s,
          border-color 0.1s;
      }

      #browse-btn:hover {
        background: #414141;
        border-color: #777;
      }

      #browse-btn:focus-visible {
        outline: 2px solid #6a9eff;
        outline-offset: 2px;
      }

      #browse-btn:disabled {
        cursor: wait;
        opacity: 0.6;
      }

      #examples {
        margin-top: 16px;
      }

      #example-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin: 10px auto 0;
        max-width: 560px;
      }

      .example-btn {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        min-height: 66px;
        padding: 10px 12px;
        color: #ccc;
        background: rgba(42, 42, 42, 0.8);
        border: 1px solid #444;
        border-radius: 7px;
        cursor: pointer;
        text-align: left;
        transition:
          background 0.1s,
          border-color 0.1s;
      }

      .example-btn:hover {
        background: #353535;
        border-color: #666;
      }

      .example-btn:disabled {
        cursor: wait;
        opacity: 0.6;
      }

      .example-btn:focus-visible {
        outline: 2px solid #6a9eff;
        outline-offset: 2px;
      }

      .example-btn span {
        color: #eee;
        font-size: 0.85rem;
        font-weight: 500;
      }

      .example-btn small {
        color: #888;
        font-size: 0.7rem;
        line-height: 1.3;
      }

      @media (max-width: 640px) {
        #drop-zone {
          margin: 20px;
        }

        #drop-content {
          padding: 18px;
        }

        #example-list {
          grid-template-columns: 1fr;
        }
      }

      #graph-canvas {
        display: block;
        width: 100vw;
        height: 100vh;
        position: absolute;
        inset: 0;
        z-index: 1;
      }

      #graph-gl-canvas {
        display: block;
        width: 100vw;
        height: 100vh;
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      #graph-gl-canvas.hidden {
        display: none;
      }

      #graph-canvas.hidden {
        display: none;
      }

      #load-btn {
        position: fixed;
        top: 12px;
        right: 12px;
        z-index: 10;
        padding: 6px 14px;
        background: #2a2a2a;
        color: #ccc;
        border: 1px solid #555;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
      }

      #docs-link {
        position: fixed;
        top: 14px;
        left: 16px;
        z-index: 10;
        color: #777;
        font-size: 0.75rem;
        text-decoration: none;
      }

      #docs-link:hover {
        color: #ccc;
      }

      #docs-link:focus-visible {
        outline: 2px solid #6a9eff;
        outline-offset: 2px;
      }

      #load-btn:hover {
        background: #3a3a3a;
      }

      #status {
        position: fixed;
        top: 14px;
        left: 50%;
        transform: translateX(-50%);
        color: #aaa;
        font-size: 0.8rem;
        pointer-events: none;
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      #controls {
        position: fixed;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(26, 26, 26, 0.85);
        backdrop-filter: blur(8px);
        border: 1px solid #333;
        border-radius: 10px;
        padding: 8px 14px;
        display: flex;
        align-items: center;
        user-select: none;
        z-index: 10;
      }

      #controls-row {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .control-btn {
        width: 28px;
        height: 28px;
        background: #2a2a2a;
        color: #ccc;
        border: 1px solid #444;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        transition:
          background 0.1s,
          border-color 0.1s;
      }

      .control-btn:hover {
        background: #3a3a3a;
        border-color: #666;
      }

      .control-btn:active {
        background: #444;
      }

      .control-btn:focus-visible {
        outline: 2px solid #6a9eff;
        outline-offset: 1px;
      }

      .fit-btn {
        width: auto;
        padding: 0 10px;
        font-size: 0.75rem;
        font-weight: 500;
      }

      .control-divider {
        width: 1px;
        height: 18px;
        background: #444;
        margin: 0 2px;
      }

      #zoom-label {
        font-size: 0.75rem;
        color: #999;
        min-width: 36px;
        text-align: center;
        font-variant-numeric: tabular-nums;
      }

      #zoom-slider {
        width: 100px;
        height: 4px;
        appearance: none;
        background: #333;
        border-radius: 2px;
        outline: none;
        cursor: pointer;
      }

      #zoom-slider::-webkit-slider-thumb {
        appearance: none;
        width: 14px;
        height: 14px;
        background: #888;
        border: 1px solid #555;
        border-radius: 50%;
        cursor: pointer;
        transition: background 0.1s;
      }

      #zoom-slider::-webkit-slider-thumb:hover {
        background: #aaa;
      }

      #zoom-slider::-moz-range-thumb {
        width: 14px;
        height: 14px;
        background: #888;
        border: 1px solid #555;
        border-radius: 50%;
        cursor: pointer;
      }

      #zoom-slider:focus-visible {
        outline: 2px solid #6a9eff;
        outline-offset: 2px;
        border-radius: 4px;
      }

      .hidden {
        display: none !important;
      }
    </style>
  </body>
</html>
